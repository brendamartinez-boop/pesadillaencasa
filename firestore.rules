rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Checks if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: Checks if the user is a member of the specific family
    function isFamilyMember(familyId) {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid));
    }

    // Helper: Retrieves the member profile of the caller
    function getMemberProfile(familyId) {
      return get(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid)).data;
    }

    // Helper: Checks if the logged-in member has Admin (Parent) privileges
    function isFamilyAdmin(familyId) {
      return isFamilyMember(familyId) && 
        getMemberProfile(familyId).role == 'admin';
    }

    // Helper: Validates if the local timestamp sits between January 1st and January 7th
    function isWrappedDatePeriod() {
      // 1 January is Day 1 of Month 1 (or Month 0 to 1 depending on system ISO)
      // We check request.time.month() == 1 and request.time.day() >= 1 && request.time.day() <= 7;
      return request.time.month() == 1 && request.time.day() >= 1 && request.time.day() <= 7;
    }

    // --- Core Family documents ---
    match /families/{familyId} {
      allow read: if isFamilyMember(familyId);
      allow create: if isAuthenticated();
      // Only admins can change family structural configurations
      allow update, delete: if isFamilyAdmin(familyId);

      // --- Members list ---
      match /members/{uid} {
        allow read: if isFamilyMember(familyId);
        // Any authenticated user can register themselves on joining (with default 'child' roles initially)
        allow create: if isAuthenticated() && request.resource.data.role == 'child';
        // Only Admins can modify other members, toggle parental blocks, or elevate roles.
        // Members can update their own photURL only.
        allow update: if isFamilyAdmin(familyId) || 
          (isAuthenticated() && request.auth.uid == uid && 
           request.resource.data.role == resource.data.role && 
           request.resource.data.points == resource.data.points);
        allow delete: if isFamilyAdmin(familyId);
      }

      // --- Chores & Tasks ---
      match /tasks/{taskId} {
        allow read: if isFamilyMember(familyId);
        
        // Children (Hijos) can ONLY create task proposals (isProposal == true).
        // Admins can create normal chores directly.
        allow create: if isFamilyAdmin(familyId) || 
          (isFamilyMember(familyId) && request.resource.data.isProposal == true && request.resource.data.createdBy == request.auth.uid);
        
        // Only Admins can edit details, approve proposals, delete chores, or mark tasks as completed.
        allow update, delete: if isFamilyAdmin(familyId);
      }

      // --- Rewards store ---
      match /rewards/{rewardId} {
        allow read: if isFamilyMember(familyId);
        // Only admins can create or activate/deactivate store items. Children can only propose (active == false).
        allow create: if isFamilyAdmin(familyId) || 
          (isFamilyMember(familyId) && request.resource.data.active == false);
        allow update, delete: if isFamilyAdmin(familyId);
      }

      // --- Shared Shopping List ---
      match /shopping/{itemId} {
        // Any family member can read, add, or toggle bought/unbought items.
        allow read, write: if isFamilyMember(familyId);
      }

      // --- Conversation Messages ---
      match /messages/{msgId} {
        allow read: if isFamilyMember(familyId);
        // Members who aren't globally app-blocked can write messages
        allow create: if isFamilyMember(familyId) && 
          getMemberProfile(familyId).blocked.all == false;
        allow update, delete: if isFamilyAdmin(familyId);
      }

      // --- Historical Points Ledger ---
      match /pointsHistory/{uid}/records/{recordId} {
        // Only the member or an Admin can read their graph logs.
        allow read: if isFamilyMember(familyId) && (request.auth.uid == uid || isFamilyAdmin(familyId));
        // Direct writes are strictly prohibited to prevent point spoofing.
        // Points history records can only be registered via secure Cloud Functions or verified batch calls.
        allow write: if false; 
      }

      // --- Annual Wrapped Analytics doc ---
      // Security rule guarantees physical lockout outside January 1-7.
      match /wrappedStats/{docId} {
        allow read: if isFamilyMember(familyId) && isWrappedDatePeriod();
        allow write: if false; // System generated only.
      }
    }
  }
}
